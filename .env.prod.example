# ReadyJLMirror — PRODUCTION environment template
# Copy to .env.prod, fill CHANGE_ME values, then:
#
#   set -a && source .env.prod && set +a
#   bash scripts/setup_prod_secrets.sh   # creates secrets/ files
#   ./deploy.sh                          # first pass (pauses for BAO_TOKEN)
#   echo "BAO_TOKEN=$(cat secrets/bao_token)" >> .env.prod
#   ./deploy.sh                          # second pass — full stack
#
# This file is intentionally committed WITHOUT real secrets.
# .env.prod (with real values) is gitignored.

# ------------------------------------------------------------------
# Domains (Caddy handles TLS termination — services run plain HTTP)
# ------------------------------------------------------------------
PUBLIC_DOMAIN=CHANGE_ME            # e.g. argos.yourdomain.com
KC_DOMAIN=CHANGE_ME                # e.g. auth.yourdomain.com
CADDY_ACME_EMAIL=CHANGE_ME         # e.g. admin@yourdomain.com

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
DEV_AUTH_BYPASS=false
BILLING_ADAPTER=jl-metered

# ------------------------------------------------------------------
# BFF (public boundary)
# ------------------------------------------------------------------
BFF_HOST=0.0.0.0
BFF_PORT=8080
BFF_PUBLIC_URL=https://CHANGE_ME   # same as PUBLIC_DOMAIN
BFF_INTERNAL_SECRET=CHANGE_ME      # min 32 chars random

COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8

# TLS — Caddy terminates TLS; services communicate over plain HTTP internally.
# Leave these empty. Future mTLS hardening will use SPIFFE/SPIRE.
TLS_CERT_FILE=
TLS_KEY_FILE=
API_MTLS=
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
API_CA_FILE=
BFF_CLIENT_CERT_FILE=
BFF_CLIENT_KEY_FILE=
WORKER_CLIENT_CERT_FILE=
WORKER_CLIENT_KEY_FILE=

# ------------------------------------------------------------------
# API (internal — accessed via Docker network, no TLS needed)
# ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_INTERNAL_URL=http://api:8000

# ------------------------------------------------------------------
# Keycloak (OIDC)
# ------------------------------------------------------------------
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=https://CHANGE_ME   # same as KC_DOMAIN
KEYCLOAK_REALM=jlmirror
KEYCLOAK_CLIENT_ID=jlmirror-bff
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME       # min 16 chars
KC_HOSTNAME=CHANGE_ME                   # same as KC_DOMAIN
KC_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=jlmirror
DB_USER=jlmirror_app
DB_PASSWORD=CHANGE_ME            # password for jlmirror_app role
DB_POOL_MIN=2
DB_POOL_MAX=10

POSTGRES_PASSWORD=CHANGE_ME      # password for jlmirror_owner (superuser)
APP_DB_PASSWORD=CHANGE_ME        # same as DB_PASSWORD
WORKER_DB_PASSWORD=CHANGE_ME     # separate password for jlmirror_worker

# ------------------------------------------------------------------
# Workers
# ------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_OUTBOX_BATCH_SIZE=10
ALERTING_WEBHOOK_URL=

# ------------------------------------------------------------------
# Secrets & credentials (OpenBao)
# ------------------------------------------------------------------
BAO_ADDR=http://openbao:8200
CREDENTIALS_DIR=secrets
BAO_TOKEN=CHANGE_ME_after_first_deploy   # see deploy.sh first-pass output
OPENBAO_UNSEAL_KEY_PATH=./secrets/openbao/unseal.key

# ------------------------------------------------------------------
# Notification delivery (G9)
# ------------------------------------------------------------------
NOTIFICATION_CALLBACK_SECRET=CHANGE_ME
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# ------------------------------------------------------------------
# Email (SMTP) — optional; unset = notification emails silently discarded
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=ssl

# ------------------------------------------------------------------
# ITSM (G10/G11) — optional
# ------------------------------------------------------------------
ITSM_WEBHOOK_URL=
ITSM_WEBHOOK_TOKEN=
ITSM_TIMEOUT=15

# ------------------------------------------------------------------
# AIOps (G12) — optional; unset = AIOps disabled
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# Web Push (VAPID — RFC 8292)
# Generate: python -m scripts.gen_vapid
# ------------------------------------------------------------------
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_CLAIMS_EMAIL=CHANGE_ME

# ------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME         # min 32 chars random

# ------------------------------------------------------------------
# Egress (provider outbound)
# ------------------------------------------------------------------
EGRESS_ALLOW_HOSTS=              # comma-separated hostnames of Zabbix instances
EGRESS_ALLOW_PRIVATE_IPS=false
