# ReadyJLMirror environment configuration (development defaults)
# Copy to .env and override for your environment.

# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# API (internal — reached through the BFF only)
API_HOST=0.0.0.0
API_PORT=8000
API_INTERNAL_URL=http://localhost:8000

# BFF (public boundary — browser talks only to this)
BFF_HOST=0.0.0.0
BFF_PORT=8080
BFF_PUBLIC_URL=http://localhost:8080
BFF_INTERNAL_SECRET=dev-internal-secret-change-me
# Optional dev TLS: python -m scripts.dev_tls generates secrets/tls/
# then point the BFF at it (and switch BFF_PUBLIC_URL to https):
# TLS_CERT_FILE=/run/secrets/tls/cert.pem
# TLS_KEY_FILE=/run/secrets/tls/key.pem

# Opt-in mTLS BFF -> API (service identity): python -m scripts.dev_tls
# generates secrets/tls/{ca,api-cert,api-key,bff-cert,bff-key}.pem
# API_MTLS=1
# API_TLS_CERT_FILE=/run/secrets/tls/api-cert.pem
# API_TLS_KEY_FILE=/run/secrets/tls/api-key.pem
# API_CA_FILE=/run/secrets/tls/ca.pem
# BFF_CLIENT_CERT_FILE=/run/secrets/tls/bff-cert.pem
# BFF_CLIENT_KEY_FILE=/run/secrets/tls/bff-key.pem
# API_INTERNAL_URL=https://api:8443
# API_PORT=8443

# OpenBao dev secrets backend — persistent (raft storage + static
# auto-unseal). First start runs bao-init which writes the root token
# to secrets/bao_token; services resolve it automatically when
# BAO_TOKEN is unset. To materialize KV into secrets/ files instead:
#   python -m scripts.bao_sync --seed
# BAO_ADDR=http://openbao:8200     (http://localhost:8200 from host)
# BAO_TOKEN=                     (defaults to secrets/bao_token)

# Keycloak (OIDC — IR-D-001 candidate)
KEYCLOAK_INTERNAL_URL=http://localhost:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=jlmirror
KEYCLOAK_CLIENT_ID=jlmirror-bff
KEYCLOAK_CLIENT_SECRET=dev-bff-secret-change-me

# Session
SESSION_LIFETIME_HOURS=8
COOKIE_SECURE=false

# Dev-only: simulate OIDC callback without Keycloak (NEVER in production)
DEV_AUTH_BYPASS=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jlmirror
DB_USER=jlmirror_app
DB_PASSWORD=jlmirror_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Development identity defaults
DEV_PRINCIPAL_ID=dev-local-user
DEV_TENANT_ID=tenant:dev
DEV_CREDENTIAL_GENERATION=credential-gen-dev-1

# Workers
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_OUTBOX_BATCH_SIZE=10

# Monitoring providers — credential resolution (chained):
#   1. OpenBao KV v2 at BAO_ADDR              (secret/data/jlmirror/credentials/<ref>)
#   2. CREDENTIALS_DIR/<binding-ref>.token    (mounted secrets; prod: Vault/OpenBao agent)
#   3. ZABBIX_CRED_<REF> env fallback         (dev only)
# REF = credential_binding_ref uppercased, non-alnum -> _
# e.g. credential_binding_ref "cred-binding-1" -> secrets/cred-binding-1.token
#                                              or ZABBIX_CRED_CRED_BINDING_1
CREDENTIALS_DIR=secrets
ZABBIX_CRED_CRED_BINDING_1=
EGRESS_ALLOW_HOSTS=
# Intranet providers (private-IP targets) need this IN ADDITION to
# the allowlist; DNS pinning still applies when the host resolves:
# EGRESS_ALLOW_PRIVATE_IPS=true
# Local-dev escape hatch only — never set in deployed environments:
# EGRESS_ALLOW_ALL_HOSTS=true
# Enterprise CA bundle for provider TLS endpoints (private CAs):
# PROVIDER_CA_FILE=/run/secrets/tls/ca.pem

# Real Zabbix provider profile (docker compose --profile zabbix):
#   docker compose --profile zabbix up -d
#   python -m scripts.dev_tls && python -m scripts.zabbix_seed
#   then create a source with provider_base_url=https://zabbix-web:8443,
#   host_group_refs=[<seeded groupid>], credential_binding_ref=cred-binding-1

# Alerting publication channel (dev: empty = dev-log simulated receipt)
ALERTING_WEBHOOK_URL=

# G9 notification delivery — WhatsApp adapter + callback verification.
# Dev defaults: adapter posts to the BFF dev sink (logged, no real send);
# callbacks to /api/v1/alerting/notifications/callback are HMAC-verified.
# Production: point WHATSAPP_API_URL at the real provider, set the token
# via secrets (mounted file/env). The callback secret FAILS CLOSED outside
# development — unset or the dev literal returns 503; tenant routing is
# derived from the dispatch-time provider_ref_binding, never from env.
WHATSAPP_API_URL=http://bff:8080/dev/whatsapp
WHATSAPP_ACCESS_TOKEN=
NOTIFICATION_CALLBACK_SECRET=dev-callback-secret

# G10 ITSM provider link — provider-neutral ticket sync (worker).
# Dev default: unset = simulated provider, deterministic dev-ticket-*
# refs — exercises the full outbox/claim/retry/reconcile path without
# credentials. Production: point at a governed ITSM bridge and put the
# token behind a credential binding (same rule as Zabbix/WhatsApp).
ITSM_PROVIDER_URL=
